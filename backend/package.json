{
  "name": "expensemate-backend",
  "version": "2.0.0",
  "description": "Simple ExpenseMate Express.js Server for University Software Construction Assignment",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --forceExit",
    "migrate": "node db/migrate.js up",
    "migrate:status": "node db/migrate.js status",
    "migrate:down": "node db/migrate.js down",
    "db:fingerprint": "node db/fingerprint.js",
    "regression:compare": "node scripts/regressionCompare.js",
    "test:coverage": "jest --forceExit --coverage --coverageReporters=text-summary",
    "metrics": "node scripts/metrics.js ."
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "collectCoverageFrom": [
      "controllers/**/*.js",
      "services/**/*.js",
      "repositories/**/*.js",
      "db/**/*.js",
      "utils/**/*.js",
      "routes/**/*.js",
      "server.js",
      "container.js"
    ]
  }
}
